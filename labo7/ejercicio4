#include <iostream>
using namespace std;

int main() {
    int opcion;
    double saldo = 3000, cantidad;

    do {
        cout << "Saldo actual: $" << saldo << endl;
        cout << "1. Depositar" << endl;
        cout << "2. Retirar" << endl;
        cout << "3. Salir" << endl;
        cout << "Seleccione una opcion: ";
        cin >> opcion;

        switch (opcion) {

            case 1:
                cout << "Ingrese cantidad a depositar: ";
                cin >> cantidad;

                if (cantidad > 0) {
                    saldo += cantidad;
                    cout << "Deposito realizado." << endl;
                } else {
                    cout << "Cantidad invalida." << endl;
                }
                break;

            case 2:
                cout << "Ingrese cantidad a retirar: ";
                cin >> cantidad;

                if (cantidad > 0 && cantidad <= saldo) {
                    saldo -= cantidad;
                    cout << "Retiro realizado." << endl;
                } else {
                    cout << "Cantidad invalida o saldo insuficiente." << endl;
                }
                break;

            case 3:
                cout << "Gracias por utilizar el cajero!" << endl;
                break;

            default:
                cout << "Opcion invalida." << endl;
        }

    } while (opcion != 3);

    return 0;
}